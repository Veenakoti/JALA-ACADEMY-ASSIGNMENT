// 8 - equalsIgnoreCase(), startsWith(), endsWith() and compareTo()
import java.util.Scanner;

public class StringMethods {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter First String: ");
        String str1 = sc.nextLine();

        System.out.print("Enter Second String: ");
        String str2 = sc.nextLine();

        // equalsIgnoreCase()
        System.out.println("equalsIgnoreCase(): "
                + str1.equalsIgnoreCase(str2));

        // startsWith()
        System.out.println("startsWith(\"Java\"): "
                + str1.startsWith("Java"));

        // endsWith()
        System.out.println("endsWith(\"Program\"): "
                + str1.endsWith("Program"));

        // compareTo()
        System.out.println("compareTo(): "
                + str1.compareTo(str2));

    }
}

// 9 - Trimming strings with trim()
import java.util.Scanner;

public class TrimString {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a String with spaces: ");
        String str = sc.nextLine();

        System.out.println("Before trim: \"" + str + "\"");
        System.out.println("After trim: \"" + str.trim() + "\"");
    }
}

// 10 - Replacing characters in strings with replace()
import java.util.Scanner;

public class ReplaceCharacter {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a String: ");
        String str = sc.nextLine();

        System.out.print("Enter character to replace: ");
        char oldChar = sc.next().charAt(0);

        System.out.print("Enter new character: ");
        char newChar = sc.next().charAt(0);

        String result = str.replace(oldChar, newChar);

        System.out.println("Original String: " + str);
        System.out.println("Modified String: " + result);

        sc.close();
    }
}

// 11 - Splitting strings with split()
import java.util.Scanner;

public class SplitString {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a String: ");
        String str = sc.nextLine();

        String[] words = str.split(" ");

        System.out.println("After Splitting:");

        for (String word : words) {
            System.out.println(word);
        }

        sc.close();
    }
}

// 12 - Converting Numbers to Strings with valueOf()
public class NumberToString {
    public static void main(String[] args) {

        int num = 100;
        double d = 25.75;

        // Convert numbers to String
        String str1 = String.valueOf(num);
        String str2 = String.valueOf(d);

        System.out.println("Integer String: " + str1);
        System.out.println("Double String: " + str2);

        System.out.println("Type of str1: " + ((Object)str1).getClass().getSimpleName());
        System.out.println("Type of str2: " + ((Object)str2).getClass().getSimpleName());
    }
}

