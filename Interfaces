// 6 - Create an interface with a default method and implement it in a class. Do not provide implementation to the default method and call the method.
// Interface
interface MyInterface {

    // Default Method
    default void display() {
        System.out.println("Default method in Interface");
    }
}

// Implementing Class
class Demo implements MyInterface {

    public static void main(String[] args) {

        Demo obj = new Demo();

        // Calling default method
        obj.display();
    }
}

// 7 - Create an interface and inherit it from the other interface.
// Parent Interface
interface Interface1 {

    void method1();
}

// Child Interface inheriting Parent Interface
interface Interface2 extends Interface1 {

    void method2();
}

// Implementing Class
class Demo implements Interface2 {

    @Override
    public void method1() {
        System.out.println("Method 1 from Interface1");
    }

    @Override
    public void method2() {
        System.out.println("Method 2 from Interface2");
    }

    public static void main(String[] args) {

        Demo obj = new Demo();

        obj.method1();
        obj.method2();
    }
}

/* 8 - Create a PUBLIC interface with fields and methods, fields should have values assigned.
Implement this interface to some class and print the values of the interface fields and
call the interface methods */
public interface MyInterface {

    // Interface Fields (public, static, final by default)
    int ID = 101;
    String NAME = "Java";

    // Abstract Method
    void display();
}

class Demo implements MyInterface {

    @Override
    public void display() {
        System.out.println("Interface Method Called");
    }

    public static void main(String[] args) {

        // Printing Interface Fields
        System.out.println("ID: " + MyInterface.ID);
        System.out.println("Name: " + MyInterface.NAME);

        // Calling Interface Method
        Demo obj = new Demo();
        obj.display();
    }
}

// 9 -  Create a PRIVATE or PROTECTED interface and print the values as above scenario
public class Outer {

    private interface MyInterface {
        int ID = 101;
        void display();
    }

    private static class Demo implements MyInterface {

        public void display() {
            System.out.println("ID: " + ID);
            System.out.println("Private Interface Method Called");
        }
    }

    public static void main(String[] args) {

        Demo obj = new Demo();
        obj.display();
    }
}

public class Outer {

    protected interface MyInterface {
        int ID = 101;
        void display();
    }

    static class Demo implements MyInterface {

        public void display() {
            System.out.println("ID: " + ID);
            System.out.println("Protected Interface Method Called");
        }
    }

    public static void main(String[] args) {

        Demo obj = new Demo();
        obj.display();
    }
}

// 10 - Create an interface with private, public and protected fields.
// Ans - In Java, interface fields cannot be private or protected.
interface MyInterface {

    int ID = 101;
    String NAME = "Java";
}

public class Demo {

    public static void main(String[] args) {

        System.out.println("ID: " + MyInterface.ID);
        System.out.println("Name: " + MyInterface.NAME);
    }
}

// 11 -  Create an interface with static final variable
// Interface
interface MyInterface {

    // Static Final Variables
    static final int ID = 101;
    static final String NAME = "Java";
}

// Main Class
public class Demo {

    public static void main(String[] args) {

        // Accessing Interface Variables
        System.out.println("ID: " + MyInterface.ID);
        System.out.println("Name: " + MyInterface.NAME);
    }
}