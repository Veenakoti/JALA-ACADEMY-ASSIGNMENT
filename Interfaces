// 1 - Create an interface with only one method and implement it in a class. Call the method implemented.
// Interface
interface MyInterface {

    void display();
}

// Implementing Class
class Demo implements MyInterface {

    @Override
    public void display() {
        System.out.println("Method implemented from Interface");
    }

    public static void main(String[] args) {

        // Creating object
        Demo obj = new Demo();

        // Calling implemented method
        obj.display();
    }
}

// *2* - Create an interface with two methods, but implement only one in a class. Call the method implemented.
//***************************************//
// Interface
interface MyInterface {

    void method1();

    void method2();
}

// Abstract Class implementing only one method
abstract class Demo implements MyInterface {

    @Override
    public void method1() {
        System.out.println("Method 1 implemented");
    }
}

// Child Class implementing remaining method
class Test extends Demo {

    @Override
    public void method2() {
        System.out.println("Method 2 implemented");
    }

    public static void main(String[] args) {

        Test obj = new Test();

        obj.method1();
    }
}

// 3 - Use Interface instances to call the implemented method in the implemented class
// Interface
interface MyInterface {

    void display();
}

// Implementing Class
class Demo implements MyInterface {

    @Override
    public void display() {
        System.out.println("Method implemented in Demo class");
    }

    public static void main(String[] args) {

        // Interface reference, Demo object
        MyInterface obj = new Demo();

        // Calling implemented method
        obj.display();
    }
}

// 4 - Create two interfaces with one method each. Implement these two interfaces in one class. 
// First Interface
interface Interface1 {
    void method1();
}

// Second Interface
interface Interface2 {
    void method2();
}

// Class implementing both interfaces
class Demo implements Interface1, Interface2 {

    @Override
    public void method1() {
        System.out.println("Method 1 from Interface1");
    }

    @Override
    public void method2() {
        System.out.println("Method 2 from Interface2");
    }

    public static void main(String[] args) {

        Demo obj = new Demo();

        obj.method1();
        obj.method2();
    }
}

