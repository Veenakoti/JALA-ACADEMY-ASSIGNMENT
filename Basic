// 4 - Define variables for different Data Types int, Boolean, char, float, double and print on the Console
public class DataTypesDemo {
    public static void main(String[] args) {

        int num = 100;
        boolean status = true;
        char grade = 'A';
        float price = 99.99f;
        double salary = 55000.75;

        System.out.println("Integer Value: " + num);
        System.out.println("Boolean Value: " + status);
        System.out.println("Character Value: " + grade);
        System.out.println("Float Value: " + price);
        System.out.println("Double Value: " + salary);
    }
}

// 5 - Define the local and Global variables with the same name and print both variables andunderstand the scope of the variables
public class VariableScope {

    
    int num = 100;

    public void display() {

        int num = 50;

        System.out.println("Local Variable: " + num);
        System.out.println("Global Variable: " + this.num);
    }

    public static void main(String[] args) {
        VariableScope obj = new VariableScope();
        obj.display();
    }
}

