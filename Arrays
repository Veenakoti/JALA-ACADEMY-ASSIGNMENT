// 18 - Write a program to remove the duplicate elements and return the new array
public class RemoveDuplicates {

    static int[] removeDuplicates(int[] arr) {

        int[] temp = new int[arr.length];
        int count = 0;

        for (int i = 0; i < arr.length; i++) {
            boolean isDuplicate = false;

            for (int j = 0; j < count; j++) {
                if (arr[i] == temp[j]) {
                    isDuplicate = true;
                    break;
                }
            }

            if (!isDuplicate) {
                temp[count] = arr[i];
                count++;
            }
        }

        int[] result = new int[count];

        for (int i = 0; i < count; i++) {
            result[i] = temp[i];
        }

        return result;
    }

    public static void main(String[] args) {

        int[] arr = {10, 20, 30, 20, 40, 10, 50};

        int[] newArray = removeDuplicates(arr);

        System.out.print("Array after removing duplicates: ");
        for (int num : newArray) {
            System.out.print(num + " ");
        }
    }
}

// 19 - Write a function to find the missing number of sorted array of 1 to 100
public class MissingNumber {

    static int findMissingNumber(int[] arr) {

        int n = 100;

        int expectedSum = n * (n + 1) / 2;
        int actualSum = 0;

        for (int i = 0; i < arr.length; i++) {
            actualSum += arr[i];
        }

        return expectedSum - actualSum;
    }

    public static void main(String[] args) {

        int[] arr = new int[99];

        int index = 0;

        for (int i = 1; i <= 100; i++) {
            if (i != 57) { // Missing number
                arr[index++] = i;
            }
        }

        System.out.println("Missing Number: " + findMissingNumber(arr));
    }
}