// 1 - Write a program to read text from .txt file using InputStream
import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStream;

public class ReadFileUsingInputStream {

    public static void main(String[] args) {

        try {
            // Open the text file
            InputStream input = new FileInputStream("sample.txt");

            int data;

            // Read the file character by character
            while ((data = input.read()) != -1) {
                System.out.print((char) data);
            }

            // Close the stream
            input.close();

        } catch (IOException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}

// 2 - Write a program to write text to .txt file using OutputStream
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.OutputStream;

public class WriteFileUsingOutputStream {

    public static void main(String[] args) {

        try {
            // Create/Open the text file
            OutputStream output = new FileOutputStream("sample.txt");

            // Text to write
            String text = "Hello Java\nWelcome to File Handling.";

            // Convert String to byte array
            byte[] bytes = text.getBytes();

            // Write bytes to the file
            output.write(bytes);

            // Close the stream
            output.close();

            System.out.println("Text written to file successfully.");

        } catch (IOException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}

